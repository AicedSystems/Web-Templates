# Required application and database settings
APP_ENV=production
SECRET_KEY=generate-a-long-random-secret
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE
EDITOR_USERNAME=choose-a-private-editor-username
EDITOR_PASSWORD=choose-a-long-unique-password

# Required for managed image, video, and PDF uploads
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=your-server-side-supabase-secret-key
SUPABASE_STORAGE_BUCKET=site-media

# Required before enabling public lead forms
FOLLOW_UP_BOSS_API_KEY=your-follow-up-boss-user-api-key
FOLLOW_UP_BOSS_SYSTEM=your-registered-system-name
FOLLOW_UP_BOSS_SYSTEM_KEY=your-registered-system-key

# Optional: required only for Aiced Bot article enhancement
OPENAI_API_KEY=your-openai-api-key
OPENAI_ENHANCEMENT_MODEL=gpt-4.1-mini

FLASK_DEBUG=0
